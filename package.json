{
  "name": "masjidnurulhuda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "node --test tests/**/*.test.mjs",
    "test:migrations": "node tests/scripts/p0-migrations.mjs",
    "test:critical-flow:d1": "node tests/scripts/p05-wrangler-critical-flow.mjs",
    "test:e2e:browser": "node tests/scripts/p05-browser-e2e.mjs",
    "admin:provision:local": "node scripts/provision-admin.mjs",
    "deploy:testing": "npm run build && wrangler pages deploy dist --project-name masjidnurulhuda-testing --branch testing --commit-dirty=true",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name masjidnurulhuda",
    "db:create": "wrangler d1 migrations create masjidnurulhuda-db",
    "db:apply:local": "wrangler d1 migrations apply masjidnurulhuda-db --local",
    "db:apply:remote": "wrangler d1 migrations apply masjidnurulhuda-db --remote",
    "db:drop:local": "wrangler d1 execute masjidnurulhuda-db --local --command=\"DROP TABLE IF EXISTS d1_migrations; DROP TABLE IF EXISTS kas_masjid; DROP TABLE IF EXISTS users; DROP TABLE IF EXISTS kategori_kas; DROP TABLE IF EXISTS periode; DROP TABLE IF EXISTS seksi_pengurus;\"",
    "db:reset:local": "npm run db:drop:local && npm run db:apply:local"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@headlessui/vue": "^1.7.23",
    "@hono/vite-dev-server": "^0.25.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.14",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.7",
    "shadcn-vue": "^2.6.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.83.0"
  }
}
